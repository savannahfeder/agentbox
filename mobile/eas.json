{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production"
    },
    "store": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_STORE_BUILD": "1"
      }
    },
    "store-launch-test": {
      "extends": "launch-test",
      "env": {
        "EXPO_PUBLIC_STORE_BUILD": "1"
      }
    },
    "launch-test": {
      "extends": "base",
      "distribution": "internal",
      "withoutCredentials": true,
      "environment": "production",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826402748"
      }
    },
    "store": {
      "extends": "production"
    }
  }
}
